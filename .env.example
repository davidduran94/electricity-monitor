# Configurar secretos directamente en Vercel; nunca poner valores reales en Git.
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
# 64 caracteres hexadecimales aleatorios para cifrar la sesión OAuth.
TESLA_SESSION_SECRET=
TESLA_FLEET_API_BASE_URL=https://fleet-api.prd.na.vn.cloud.tesla.com
TESLA_PARTNER_DOMAIN=electricity-monitor-smoky.vercel.app
# Opcional, únicamente para verificar la pareja de claves al registrar localmente.
# La integración de lectura y el registro no necesitan enviar la clave privada.
# TESLA_PARTNER_PRIVATE_KEY=
